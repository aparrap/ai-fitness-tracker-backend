NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Server-only Supabase Secret key (sb_secret_...).
# Never expose this key in a browser/mobile client.
SUPABASE_SECRET_KEY=

# Seeded profile used by the single-user MVP.
FITNESS_PROFILE_ID=8d553210-69a8-4f25-91be-000000000001

# Optional frontend origin. Use "*" only for local development if needed.
CORS_ORIGIN=http://localhost:3001
